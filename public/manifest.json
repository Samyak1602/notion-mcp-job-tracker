{
  "manifest_version": 3,
  "name": "Notion MCP Job Tracker",
  "version": "1.0.0",
  "description": "Chrome Extension built with React, TypeScript, and Tailwind CSS",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
